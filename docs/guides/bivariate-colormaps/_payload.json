Moving along one axis changes the first variable's color contribution",[182,215,216],{},"Moving along the other axis changes the second variable's",[174,218,220],{"id":219},"export","Export",[165,222,223,224,228],{},"Bivariate plots can be exported like any other plot; the exported image draws the bivariate strip and its tick labels. See ",[225,226,227],"a",{"href":82},"Animation & export",".",[230,231,233],"callout",{"icon":232},"i-lucide-lightbulb","Bivariate colors are harder to read for precise values — keep the univariate colorbar nearby or mention both variables and their ranges in your figure caption.",{"title":235,"searchDepth":236,"depth":236,"links":237},"",2,[238,239,240],{"id":176,"depth":236,"text":177},{"id":196,"depth":236,"text":197},{"id":219,"depth":236,"text":220},"Map two variables to a 2D color scheme.","md",null,{},{"icon":79},{"title":76,"description":241},"TXN6kSDwa29c7yIa5F9f1WE7blfNhxcEhHoZawbg8oM",[249,251],{"title":71,"path":72,"stem":73,"description":250,"icon":74,"children":-1},"Visualize local Zarr and NetCDF files offline.",{"title":81,"path":82,"stem":83,"description":252,"icon":84,"children":-1},"Keyframes, animation playback, and image\u002Fvideo export.",1790773463955]