r",[203,212,214],{"class":213},"sfazB"," --port",[203,216,218],{"class":217},"sbssI"," 8080\n",[203,220,222],{"class":205,"line":221},2,[203,223,225],{"class":224},"sHwdD","# then select \"Local Zarr\" in the dataset modal and pick your .zarr directory\n",[165,227,228],{},"Or launch straight into a store:",[194,230,234],{"className":231,"code":232,"language":233,"meta":199,"style":199},"language-julia shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","using Browzarr\nbrowzarr(; store=\"\u002Fabsolute\u002Fpath\u002Fto\u002Fzarr_file.zarr\")\n","julia",[181,235,236,241],{"__ignoreMap":199},[203,237,238],{"class":205,"line":206},[203,239,240],{},"using Browzarr\n",[203,242,243],{"class":205,"line":221},[203,244,245],{},"browzarr(; store=\"\u002Fabsolute\u002Fpath\u002Fto\u002Fzarr_file.zarr\")\n",[173,247,249],{"id":248},"local-netcdf","Local NetCDF",[165,251,252,255],{},[181,253,254],{},".nc"," files are decoded in the browser with WebAssembly (netcdf4-wasm), so most classic and HDF5-based NetCDF files work without conversion:",[194,257,259],{"className":231,"code":258,"language":233,"meta":199,"style":199},"browzarr(; store=\"\u002Fabsolute\u002Fpath\u002Fto\u002Ffile.nc\")\n",[181,260,261],{"__ignoreMap":199},[203,262,263],{"class":205,"line":206},[203,264,258],{},[266,267,269,270,274,275,278],"callout",{"icon":268},"i-lucide-info","Use ",[271,272,273],"strong",{},"absolute paths"," when passing a ",[181,276,277],{},"store"," argument.",[173,280,282],{"id":281},"tips-for-large-files","Tips for large files",[284,285,286,290,298],"ul",{},[287,288,289],"li",{},"Chunked NetCDF (HDF5) files behave much better than contiguous ones",[287,291,292,293,297],{},"Use the ",[169,294,296],{"href":295},"\u002Fessentials\u002Fvariable-selection","variable sliders"," to subset before plotting",[287,299,300,301,304],{},"Consider re-chunking to ",[181,302,303],{},"1–10 MB"," chunks for snappier interaction",[306,307,308],"style",{},"html pre.shiki cod