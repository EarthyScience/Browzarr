e","\u002Freference","6.reference",[140,145,149,154],{"title":141,"path":142,"stem":143,"icon":144},"Supported formats","\u002Freference\u002Fsupported-formats","6.reference\u002F2.supported-formats","i-lucide-file-box",{"title":146,"path":147,"stem":148,"icon":109},"Browser support","\u002Freference\u002Fbrowser-support","6.reference\u002F3.browser-support",{"title":150,"path":151,"stem":152,"icon":153},"Troubleshooting","\u002Freference\u002Ftroubleshooting","6.reference\u002F4.troubleshooting","i-lucide-wrench",{"title":155,"path":156,"stem":157,"icon":158},"FAQ","\u002Freference\u002Ffaq","6.reference\u002F5.faq","i-lucide-message-circle-question",{"id":160,"title":155,"body":161,"description":258,"extension":259,"links":260,"meta":261,"navigation":262,"path":156,"seo":263,"stem":157,"__hash__":264},"docs\u002F6.reference\u002F5.faq.md",{"type":162,"value":163,"toc":247},"minimark",[164,169,178,182,193,197,205,209,215,219,227,231,238,242],[165,166,168],"h2",{"id":167},"does-my-data-leave-my-machine","Does my data leave my machine?",[170,171,172,173,177],"p",{},"No. Browzarr runs entirely in your browser — chunks are fetched ",[174,175,176],"strong",{},"directly"," from the store (remote bucket or your local disk via the offline app) and processed locally. There is no backend that stores or proxies your data.",[165,179,181],{"id":180},"do-i-need-to-install-anything","Do I need to install anything?",[170,183,184,185,192],{},"Not for the ",[186,187,191],"a",{"href":188,"rel":189},"https:\u002F\u002Fbrowzarr.io",[190],"nofollow","online version",". Install via npm or Julia only if you want offline use or access to local files.",[165,194,196],{"id":195},"how-large-can-my-dataset-be","How large can my dataset be?",[170,198,199,200,204],{},"Browzarr fetches and renders chunks lazily, so stores much larger than your RAM work — but the slices you plot must fit in browser memory. Subset with the variable sliders and use ",[186,201,203],{"href":202},"\u002Fguides\u002Fperformance-mode","performance mode"," for big cubes.",[165,206,208],{"id":207},"which-zarr-versions-are-supported","Which Zarr versions are supported?",[170,210,211,212,214],{},"Zarr v2 and v3 (via zarrita.js), plus Icechunk. See ",[186,213,141],{"href":142},".",[165,216,218],{"id":217},"can-i-use-browzarr-for-figures-in-a-publication","Can I use Browzarr for figures in a publication?",[170,220,221,222,214],{},"Yes — export static images or animations with the colorbar included. If Browzarr helps your research, consider citing it and starring the ",[186,223,226],{"href":224,"rel":225},"https:\u002F\u002Fgithub.com\u002FEarthyScience\u002FBrowzarr",[190],"repository",[165,228,230],{"id":229},"how-do-i-add-my-dataset-to-the-curated-catalog","How do I add my dataset to the curated catalog?",[170,232,233,234,237],{},"Open an issue or PR on the ",[186,235,226],{"href":224,"rel":236},[190]," with the store URL, a label, and a short description. Make sure the store has correct CORS settings.",[165,239,241],{"id":240},"is-browzarr-open-source","Is Browzarr open source?",[170,243,244,245,214],{},"Yes, under the Apache 2.0 license. See ",[186,246,131],{"href":132},{"title":248,"searchDepth":249,"depth":249,"links":250},"",2,[251,252,253,254,255,256,257],{"id":167,"depth":249,"text":168},{"id":180,"depth":249,"text":181},{"id":195,"depth":249,"text":196},{"id":207,"depth":249,"text":208},{"id":217,"depth":249,"text":218},{"id":229,"depth":249,"text":230},{"id":240,"depth":249,"text":241},"Frequently asked questions.","md",null,{},{"icon":158},{"title":155,"description":258},"wsb4th_s2jgAESUnUPkBNXzZW5nRQAos_aLhpcH-450",[266,260],{"title":150,"path":151,"stem":152,"description":267,"icon":153,"children":-1},"Common problems and how to fix them.",1790773465659]