ldren":139,"page":6},"Reference","\u002Freference","6.reference",[140,145,149,154],{"title":141,"path":142,"stem":143,"icon":144},"Supported formats","\u002Freference\u002Fsupported-formats","6.reference\u002F2.supported-formats","i-lucide-file-box",{"title":146,"path":147,"stem":148,"icon":109},"Browser support","\u002Freference\u002Fbrowser-support","6.reference\u002F3.browser-support",{"title":150,"path":151,"stem":152,"icon":153},"Troubleshooting","\u002Freference\u002Ftroubleshooting","6.reference\u002F4.troubleshooting","i-lucide-wrench",{"title":155,"path":156,"stem":157,"icon":158},"FAQ","\u002Freference\u002Ffaq","6.reference\u002F5.faq","i-lucide-message-circle-question",{"id":160,"title":11,"body":161,"description":177,"extension":331,"links":332,"meta":333,"navigation":334,"path":12,"seo":335,"stem":13,"__hash__":336},"docs\u002F1.getting-started\u002F1.introduction.md",{"type":162,"value":163,"toc":323},"minimark",[164,173,178,185,192,196,264,268,279,283,311],[165,166,167,168,172],"p",{},"Although the ",[169,170,171],"code",{},"browzarr.io"," user interface is pretty intuitive, there are plenty of features that deserve some dedicated space for a longer explanation. But first,",[174,175,177],"h2",{"id":176},"what-is-browzarr","What is Browzarr?",[165,179,180,184],{},[181,182,183],"strong",{},"Browzarr"," is a powerful, browser-native framework for visualizing, exploring, and analyzing Zarr and NetCDF data stores.\nLoad multi-dimensional datasets directly in the browser, interactively slice and inspect chunks, and gain insights without any backend or server setup.",[165,186,187,188,191],{},"Because everything runs client-side, your data flows ",[181,189,190],{},"directly from the store (local disk or S3\u002FHTTP bucket) to your browser"," — there is no intermediate server that processes, stores, or re-serves your data.",[174,193,195],{"id":194},"key-features","Key Features",[197,198,199,210,216,222,228,234,240,245,251],"ul",{},[200,201,202,205,206,209],"li",{},[181,203,204],{},"Data cubes"," — explore spatio-temporal (",[169,207,208],{},"x-y-t",") variables as interactive 3D cubes",[200,211,212,215],{},[181,213,214],{},"Globe"," — render data on a 3D sphere for spatial context",[200,217,218,221],{},[181,219,220],{},"Flat maps"," — classic rectangular 2D projections",[200,223,224,227],{},[181,225,226],{},"Point clouds"," — high-density spatial data as interactive 3D points",[200,229,230,233],{},[181,231,232],{},"Time series"," — select any pixel in any direction and plot its values over time",[200,235,236,239],{},[181,237,238],{},"Colorbar control"," — interactive bounds, colormaps, univariate and bivariate mapping",[200,241,242,244],{},[181,243,56],{}," — WebGPU-accelerated computation, including custom WGSL shaders",[200,246,247,250],{},[181,248,249],{},"Export"," — static images and animation\u002Fvideo export",[200,252,253,256,257,263],{},[181,254,255],{},"No install required"," — runs online at ",[258,259,171],"a",{"href":260,"rel":261},"https:\u002F\u002Fbrowzarr.io",[262],"nofollow",", or fully offline via npm or Julia",[174,265,267],{"id":266},"who-is-it-for","Who is it for?",[197,269,270,273,276],{},[200,271,272],{},"Earth system scientists and climate researchers who want to eyeball a data cube before writing analysis code",[200,274,275],{},"Data engineers validating Zarr stores, chunking layouts, and Icechunk repositories",[200,277,278],{},"Educators and students who need an approachable, zero-setup way to explore geospatial datasets",[174,280,282],{"id":281},"how-these-docs-are-organized","How these docs are organized",[197,284,285,290,296,301,306],{},[200,286,287,289],{},[181,288,5],{}," — installation and a first tour of the interface",[200,291,292,295],{},[181,293,294],{},"Essentials"," — the core concepts: datasets, variables, colorbar, plot settings, analytics",[200,297,298,300],{},[181,299,61],{}," — task-oriented recipes (remote data, local data, animations, bivariate maps…)",[200,302,303,305],{},[181,304,136],{}," — plot types, supported formats, browser support, troubleshooting, FAQ",[200,307,308,310],{},[181,309,121],{}," — contributing and project background",[312,313,315,316,318,319,322],"callout",{"icon":314},"i-lucide-lightbulb","New to Browzarr? Jump straight to ",[258,317,16],{"href":17},", then take the ",[258,320,321],{"href":22},"landing page tour",".",{"title":324,"searchDepth":325,"depth":325,"links":326},"",2,[327,328,329,330],{"id":176,"depth":325,"text":177},{"id":194,"depth":325,"text":195},{"id":266,"depth":325,"text":267},{"id":281,"depth":325,"text":282},"md",null,{},{"icon":14},{"title":11,"description":177},"bSDVCKUGYwMVrskozErN7ODqXk4MTd1FCmFedWtv-Cg",[332,338],{"title":16,"path":17,"stem":18,"description":339,"icon":19,"children":-1},"Run Browzarr online or offline via npm or Julia.",1790773463955]